{
  "name": "albait",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website ALBA IT SRL — case de marcat fiscale Daisy, service și soluții IT în Alba Iulia.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "test:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run test:dist",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "images": "node scripts/prepare-images.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "lucide-react": "^1.54.0",
    "motion": "~13.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "workerd@1.20261006.1": true
  }
}
