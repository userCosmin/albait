---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Range from '@/components/home/Range.astro';
import Finder from '@/components/home/Finder.astro';
import Story from '@/components/home/Story.astro';
import Solutions from '@/components/home/Solutions.astro';
import Assurance from '@/components/home/Assurance.astro';
import FaqList from '@/components/FaqList.astro';
import CtaSection from '@/components/CtaSection.astro';
import { faqSchema } from '@/lib/schema';
import { homeFaq } from '@/data/faq';
---

<BaseLayout
  title="Case de marcat fiscale și service în Alba Iulia | ALBA IT"
  description="Case de marcat fiscale Daisy și Incotex cu jurnal electronic, service și soluții IT pentru firme în Alba Iulia. ALBA IT — 0758 343 653."
  path="/"
  theme="dark"
  schema={[faqSchema(homeFaq)]}
>
  <Hero />
  <Range />
  <Finder />
  <Story />
  <Solutions />
  <Assurance />
  <FaqList items={homeFaq} eyebrow="06 — Întrebări frecvente" title="Ce ne întreabă clienții" />
  <CtaSection />
</BaseLayout>
