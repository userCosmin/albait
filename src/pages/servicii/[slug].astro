---
import { ArrowUpRight, Check, Phone } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import { services } from '@/data/services';
import { products } from '@/data/products';
import { company } from '@/data/site';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props;
const path = `/servicii/${s.slug}/`;
const crumbs = [
  { name: 'Acasă', path: '/' },
  { name: 'Servicii', path: '/servicii/' },
  { name: s.title, path },
];
const others = services.filter((o) => o.slug !== s.slug);
const isRegister = s.slug === 'service-case-de-marcat';
const interest = isRegister ? 'Service case de marcat' : 'Servicii IT pentru firmă';
---

<BaseLayout
  title={`${s.title} în Alba Iulia`}
  description={`${s.title} — ${s.short} ALBA IT, Alba Iulia. Sună la ${company.phone.display}.`}
  path={path}
  theme="dark"
  schema={[serviceSchema(s), breadcrumbSchema(crumbs)]}
>
  <PageHero eyebrow="Servicii" title={s.title} lead={s.short} crumbs={crumbs} />

  <section class="bg-paper section-y !pt-14 sm:!pt-20">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-[clamp(1.25rem,1rem+0.8vw,1.7rem)] leading-snug tracking-[-0.015em]">{s.intro}</p>

        <h2 class="eyebrow mt-14 text-muted">Ce include</h2>
        <ul class="mt-6 divide-y divide-fg/10 border-y border-fg/10">
          {
            s.points.map((pt, i) => (
              <li class="flex items-start gap-4 py-4 text-[1.02rem]" data-reveal style={`--reveal-delay: ${i * 60}`}>
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white" aria-hidden="true">
                  <Check size={14} strokeWidth={3} />
                </span>
                {pt}
              </li>
            ))
          }
        </ul>

        {
          isRegister && (
            <div class="mt-14">
              <h2 class="eyebrow text-muted">Modele pentru care oferim service</h2>
              <ul class="mt-5 flex flex-wrap gap-2">
                {products.map((p) => (
                  <li>
                    <a href={`/case-de-marcat/${p.slug}/`} class="inline-flex rounded-full border border-fg/15 bg-white px-4 py-2 font-medium hover:border-fg/40">
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-[var(--radius-card)] bg-ink-950 p-8 text-ink-100 lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <p class="eyebrow text-brand-300">Discutăm?</p>
          <p class="mt-4 text-2xl font-semibold tracking-[-0.02em]">Spuneți-ne ce aveți nevoie și revenim cu o propunere.</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={`/contact/?interes=${encodeURIComponent(interest)}#oferta`} class="btn btn-light">
              Solicită o ofertă <ArrowUpRight size={18} className="btn-icon" aria-hidden="true" />
            </a>
            <a href={company.phone.href} class="btn btn-ghost-dark tabular-nums">
              <Phone size={18} aria-hidden="true" /> {company.phone.display}
            </a>
          </div>
          <p class="mt-6 text-sm text-ink-400">{company.hours.display} · {company.showroom.street}, {company.showroom.city}</p>
        </div>
      </aside>
    </div>

    <div class="container-x mt-24 sm:mt-32">
      <h2 class="text-h3 font-semibold">Alte servicii</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((o) => (
            <li>
              <a href={`/servicii/${o.slug}/`} class="group flex h-full flex-col rounded-[var(--radius-card)] border border-fg/10 bg-white p-6 transition-colors hover:border-fg/30">
                <span class="font-semibold">{o.title}</span>
                <span class="mt-2 text-sm text-muted">{o.short}</span>
                <ArrowUpRight size={18} aria-hidden="true" className="mt-auto pt-4 text-brand-600 transition-transform group-hover:rotate-45" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
