---
import { Picture } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import CtaSection from '@/components/CtaSection.astro';
import { products } from '@/data/products';
import { registerFaq } from '@/data/faq';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

const path = '/case-de-marcat/';
const crumbs = [
  { name: 'Acasă', path: '/' },
  { name: 'Case de marcat', path },
];

const guide = [
  {
    title: 'Cine are nevoie de casă de marcat',
    text: 'Operatorii economici care vând cu amănuntul sau prestează servicii direct către populație și încasează în numerar sau cu cardul trebuie să emită bon fiscal printr-un aparat de marcat electronic fiscal, conform OUG nr. 28/1999. Există excepții prevăzute de lege; dacă nu sunteți sigur, întrebați contabilul.',
  },
  {
    title: 'Jurnal electronic și raportare la ANAF',
    text: 'Toate cele patru modele pe care le vindem au jurnal electronic pe card microSD de 8 GB și export de fișiere XML semnate pentru ANAF. Daisy Compact S trimite automat rapoartele după raportul Z, iar Succes M7 are Ethernet pentru transferul fișierelor.',
  },
  {
    title: 'Seria fiscală (NUI) și fiscalizarea',
    text: 'După achiziție, firma depune formularul C801 la ANAF prin SPV și primește numărul unic de identificare. Aparatul este apoi fiscalizat: programat cu datele firmei și trecut în modul de lucru fiscal.',
  },
  {
    title: 'Codul QR pe bonul fiscal',
    text: 'Prin OUG nr. 68/2025, sancționarea emiterii bonurilor fără cod QR a fost suspendată până la 1 noiembrie 2026. Sunați-ne pentru informații despre casa dumneavoastră de marcat.',
  },
];
---

<BaseLayout
  title="Case de marcat fiscale Daisy și Incotex în Alba Iulia"
  description="Case de marcat cu jurnal electronic: Incotex Succes M7, Succes M4, Daisy Compact S și eXpert SX-02. Ghid de alegere, fiscalizare și service în Alba Iulia."
  path={path}
  theme="dark"
  schema={[breadcrumbSchema(crumbs), faqSchema(registerFaq)]}
>
  <PageHero
    eyebrow="Case de marcat fiscale"
    title="Patru modele. "
    accent="Unul e al dumneavoastră."
    lead="Toate au jurnal electronic și export XML pentru ANAF. Diferă prin cât de mobile sunt, ce periferice acceptă și cum se conectează."
    crumbs={crumbs}
  />

  <section class="bg-paper section-y !pt-14 sm:!pt-20" aria-labelledby="modele-title">
    <div class="container-x">
      <h2 id="modele-title" class="sr-only">Modelele disponibile</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          products.map((p, i) => (
            <li data-reveal style={`--reveal-delay: ${(i % 2) * 90}`}>
              <a
                href={`/case-de-marcat/${p.slug}/`}
                class="model-card group grid h-full overflow-hidden rounded-[var(--radius-card)] border border-fg/10 bg-white sm:grid-cols-[1fr_1.1fr]"
              >
                <span class="relative flex aspect-[4/3] items-center justify-center bg-studio sm:aspect-auto">
                  <Picture
                    src={p.images[0].src}
                    alt={p.images[0].alt}
                    widths={[360, 540, 720]}
                    sizes="(min-width: 640px) 25vw, 90vw"
                    formats={['avif', 'webp']}
                    class:list={[
                      'model-media h-[72%] w-auto object-contain',
                      p.images[0].kind === 'photo' ? 'blend-multiply' : 'drop-shadow-[0_24px_28px_rgba(11,14,19,0.3)]',
                    ]}
                  />
                </span>
                <span class="flex flex-col p-7">
                  <span class="eyebrow text-brand-600">{p.model}</span>
                  <span class="mt-3 text-2xl font-semibold tracking-[-0.025em]">{p.name}</span>
                  <span class="mt-2 text-muted">{p.tagline}</span>
                  <span class="mt-6 flex flex-wrap gap-1.5">
                    {p.bestFor.slice(0, 3).map((b) => (
                      <span class="rounded-full bg-paper px-3 py-1 text-xs">{b}</span>
                    ))}
                  </span>
                  <span class="mt-auto flex items-center gap-1.5 pt-8 font-semibold text-brand-600">
                    Vezi modelul <ArrowUpRight size={16} aria-hidden="true" className="transition-transform duration-500 group-hover:rotate-45" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-muted">
        Nu știți care se potrivește? <a href="/produse/" class="font-semibold text-brand-600 underline underline-offset-4">Folosiți ghidul de alegere</a> sau sunați-ne.
      </p>
    </div>

    <div class="container-x mt-24 grid gap-12 sm:mt-32 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-brand-600">Ghid</p>
        <h2 class="mt-5 text-h2 font-semibold">Ce trebuie să știți <span class="serif-accent">înainte să cumpărați.</span></h2>
        <p class="mt-5 text-sm text-muted">Informații generale, nu consultanță juridică. Verificați situația firmei cu contabilul.</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {
          guide.map((g, i) => (
            <li class="rounded-[var(--radius-card)] border border-fg/10 bg-white p-7" data-reveal style={`--reveal-delay: ${i * 80}`}>
              <span class="font-mono text-xs text-brand-600">0{i + 1}</span>
              <h3 class="mt-4 text-lg font-semibold tracking-[-0.015em]">{g.title}</h3>
              <p class="mt-3 text-[0.97rem] leading-relaxed text-muted">{g.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FaqList items={registerFaq} id="faq-case" />
  <CtaSection />
</BaseLayout>

<style>
  .model-card :global(.model-media) {
    transition: transform 1s var(--ease-out-expo);
  }
  .model-card:hover :global(.model-media) {
    transform: scale(1.06) rotate(-2deg);
  }
</style>
