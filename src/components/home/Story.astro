---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import ProductStory, { type Chapter } from '@/components/react/ProductStory';
import { responsiveImage } from '@/lib/images';
import { getProduct } from '@/data/products';

const p = getProduct('incotex-succes-m7')!;
const sizes = '(min-width: 1024px) 40vw, 80vw';
const images = await Promise.all(p.images.map((img) => responsiveImage(img.src, { widths: [420, 640], sizes })));

// Every figure below comes from the Succes M7 spec sheet in src/data/products.ts
// (importer Milo Trading 2000 + official manual).
const chapters: Chapter[] = [
  {
    kicker: 'Tejgheaua',
    title: 'Sertarul de bani are portul lui.',
    text: 'Port dedicat RJ-14 pentru sertarul de bani, separat de porturile pentru periferice. Casa de marcat e gândită pentru comerț și prestări servicii.',
    figure: 'RJ-14',
    figureLabel: 'port sertar',
    image: 0,
  },
  {
    kicker: 'Periferice',
    title: 'Cântar, scanner și calculator, în același timp.',
    text: 'Două porturi seriale RJ-11 pentru PC, scanner, cântar sau afișaj extern, plus USB pentru calculator și PS/2 pentru o tastatură externă.',
    figure: '2 × RS232',
    figureLabel: 'porturi seriale',
    image: 0,
  },
  {
    kicker: 'Memoria',
    title: 'Fiecare bon, păstrat în jurnalul electronic.',
    text: 'Jurnal electronic pe card microSD de 8 GB, memorie fiscală pentru 1.830 de rapoarte zilnice și modul criptografic certificat Common Criteria EAL 4.',
    figure: '8 GB',
    figureLabel: 'jurnal electronic',
    image: 0,
  },
  {
    kicker: 'Rețea și energie',
    title: 'Ethernet pentru rapoarte, acumulator pentru pene de curent.',
    text: 'Interfața Ethernet transferă fișierele XML, iar acumulatorul de 7,4 V ține până la 60 de ore în standby sau 40.000 de linii tipărite.',
    figure: 'ETH',
    figureLabel: 'Ethernet',
    image: 0,
  },
];
---

<section class="relative bg-paper section-y" aria-labelledby="story-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow text-brand-600" data-reveal>03 — De aproape</p>
        <h2 id="story-title" class="mt-5 text-h2 font-semibold" data-reveal style="--reveal-delay: 80">
          {p.name}: <span class="serif-accent">toată tejgheaua</span>, într-un singur aparat.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end" data-reveal style="--reveal-delay: 160">
        <a href={`/case-de-marcat/${p.slug}/`} class="btn btn-ghost">
          Specificații complete <ArrowRight size={18} className="btn-icon" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-14 lg:mt-20">
      <ProductStory
        client:visible
        chapters={chapters}
        images={images}
        alts={p.images.map((i) => i.alt)}
        productName={p.name}
      />
    </div>

    <div class="mt-6 flex flex-col items-start justify-between gap-6 rounded-[var(--radius-card)] bg-ink-950 p-7 text-ink-100 sm:flex-row sm:items-center sm:p-9">
      <p class="max-w-xl text-lg">
        Vreți un {p.name} pentru magazinul dumneavoastră? Vă spunem ce mai trebuie pregătit până la primul bon.
      </p>
      <a href={`/contact/?interes=${encodeURIComponent(p.name)}#oferta`} class="btn btn-light shrink-0">
        Cere ofertă pentru {p.model} <ArrowUpRight size={18} className="btn-icon" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
