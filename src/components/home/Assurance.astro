---
import { ArrowUpRight, BadgeCheck, Award, Building2 } from 'lucide-react';
import { company, credentials } from '@/data/site';

const steps = [
  {
    title: 'Alegeți modelul',
    text: 'Ne spuneți cum lucrați — la tejghea, pe drum, cu cântar sau sertar — și vă recomandăm casa de marcat potrivită.',
  },
  {
    title: 'Obțineți seria fiscală',
    text: 'Firma dumneavoastră depune la ANAF formularul C801, online, prin SPV, și primește numărul unic de identificare.',
  },
  {
    title: 'Fiscalizare și instruire',
    text: 'Aparatul este programat cu datele firmei și trecut în modul fiscal. Vă arătăm cum emiteți bonul și rapoartele X și Z.',
  },
  {
    title: 'Service pe parcurs',
    text: 'Rămânem aproape, în Alba Iulia, pentru întrebări, role de hârtie și intervenții la modelele distribuite.',
  },
];
const icons = [BadgeCheck, Award, Building2];
---

<section class="bg-paper section-y" aria-labelledby="proces-title">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <p class="eyebrow text-brand-600" data-reveal>05 — Pașii</p>
          <h2 id="proces-title" class="mt-5 text-h2 font-semibold" data-reveal style="--reveal-delay: 80">
            De la alegere la <span class="serif-accent">primul bon.</span>
          </h2>
          <p class="mt-6 max-w-sm text-muted" data-reveal style="--reveal-delay: 160">
            Procedura e aceeași pentru orice firmă; diferența o face cine v-o explică.
          </p>
        </div>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {
          steps.map((s, i) => (
            <li
              class="step group relative overflow-hidden rounded-[var(--radius-card)] border border-fg/10 bg-white p-7 sm:p-8"
              data-reveal
              style={`--reveal-delay: ${i * 90}`}
            >
              <span class="step-num block text-[5.5rem] font-bold leading-none tracking-[-0.06em] text-studio transition-colors duration-500 group-hover:text-brand-500">
                0{i + 1}
              </span>
              <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-3 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Trust: verifiable facts only, each with its public source. -->
    <div class="mt-24 grid gap-4 sm:mt-32 lg:grid-cols-3" aria-labelledby="incredere-title">
      <h2 id="incredere-title" class="sr-only">De ce ALBA IT</h2>
      {
        credentials.map((c, i) => {
          const Icon = icons[i];
          return (
            <a
              href={c.href}
              target="_blank"
              rel="noopener"
              class="group flex flex-col justify-between gap-10 rounded-[var(--radius-card)] bg-ink-950 p-7 text-ink-100 transition-colors hover:bg-ink-800 sm:p-8"
              data-reveal
              style={`--reveal-delay: ${i * 90}`}
            >
              <Icon size={28} className="text-brand-400" aria-hidden="true" />
              <div>
                <h3 class="text-xl font-semibold tracking-[-0.02em]">{c.title}</h3>
                <p class="mt-3 text-ink-300">{c.detail}</p>
                <p class="mt-6 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.12em] text-ink-400 group-hover:text-brand-300">
                  Sursa: {c.source} <ArrowUpRight size={14} aria-hidden="true" />
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      {company.legalName} · {company.registeredOffice.street}, {company.registeredOffice.city} · CUI {company.cui}
    </p>
  </div>
</section>
