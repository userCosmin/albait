---
import { Picture } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import { products } from '@/data/products';
import { services } from '@/data/services';
import compactM from '@/assets/products/compact-m-cutout.png';
import expertTop from '@/assets/products/expert-sx-top.jpg';

const itServices = services.filter((s) => s.slug !== 'service-case-de-marcat');
const ticker = [
  'Daisy Compact S',
  'Jurnal electronic 8 GB',
  'Daisy Compact M',
  'Raportare XML la ANAF',
  'Daisy Perfect M',
  'Sertar · cântar · cititor coduri',
  'Daisy eXpert SX',
  'Service în Alba Iulia',
  'Mentenanță IT',
  'Servere Linux',
];
---

<!-- Ticker: the hand-off from the dark hero into the light page. -->
<div class="marquee relative z-10 -mt-px overflow-hidden border-y border-white/10 bg-ink-950 py-5 text-ink-300" aria-hidden="true">
  <div class="marquee-track flex w-max gap-12 whitespace-nowrap font-mono text-sm uppercase tracking-[0.14em]">
    {
      [...ticker, ...ticker].map((t) => (
        <span class="flex items-center gap-12">
          {t}
          <span class="size-1.5 rounded-full bg-brand-500" />
        </span>
      ))
    }
  </div>
</div>

<section id="gama" class="relative rounded-t-[2.5rem] bg-paper section-y sm:rounded-t-[3.5rem]" aria-labelledby="gama-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow text-brand-600" data-reveal>01 — Ce găsiți la ALBA IT</p>
        <h2 id="gama-title" class="mt-5 text-h2 font-semibold" data-reveal style="--reveal-delay: 80">
          Echipamente fiscale și IT, <span class="serif-accent">alese cu grijă</span>, nu la grămadă.
        </h2>
      </div>
      <p class="max-w-md text-lead text-muted lg:col-span-5 lg:justify-self-end" data-reveal style="--reveal-delay: 160">
        Patru case de marcat Daisy cu jurnal electronic, service pentru ele și servicii IT pentru firme. Puțin, clar și explicat pe înțeles.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:mt-20 lg:grid-cols-12 lg:grid-rows-[auto_auto] lg:gap-5">
      <!-- Hero tile: cash registers -->
      <a
        href="/case-de-marcat/"
        class="tile group relative isolate flex min-h-[30rem] flex-col justify-between overflow-hidden rounded-[var(--radius-card)] bg-ink-950 p-7 text-ink-100 sm:p-10 lg:col-span-8 lg:row-span-2 lg:min-h-[44rem]"
        data-reveal="mask"
      >
        <div aria-hidden="true" class="grid-lines absolute inset-0 -z-10 [mask-image:radial-gradient(60%_60%_at_70%_60%,black,transparent)]"></div>
        <div aria-hidden="true" class="absolute -right-[10%] top-[30%] -z-10 size-[70%] rounded-full bg-brand-600/25 blur-[120px]"></div>
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="eyebrow text-brand-300">Case de marcat fiscale</p>
            <h3 class="mt-4 max-w-md text-h3 font-semibold">Patru modele Daisy, de la buzunar la tejghea.</h3>
          </div>
          <span class="tile-arrow flex size-12 shrink-0 items-center justify-center rounded-full border border-white/20">
            <ArrowUpRight size={20} aria-hidden="true" />
          </span>
        </div>
        <Picture
          src={compactM}
          alt="Casa de marcat Daisy Compact M"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 50vw, 90vw"
          formats={['avif', 'webp']}
          class="tile-media pointer-events-none mx-auto my-6 w-[88%] max-w-[40rem] drop-shadow-[0_40px_50px_rgba(0,0,0,0.6)] lg:my-0"
        />
        <ul class="flex flex-wrap gap-2">
          {
            products.map((p) => (
              <li class="rounded-full border border-white/15 px-3.5 py-1.5 text-sm text-ink-100">{p.name.replace('Daisy ', '')}</li>
            ))
          }
        </ul>
      </a>

      <!-- Service tile with photo on studio grey -->
      <a
        href="/servicii/service-case-de-marcat/"
        class="tile group relative flex min-h-[22rem] flex-col justify-between overflow-hidden rounded-[var(--radius-card)] bg-studio p-7 sm:p-9 lg:col-span-4"
        data-reveal="mask"
        style="--reveal-delay: 120"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow text-brand-700">Service</p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em]">Service case de marcat</h3>
          </div>
          <span class="tile-arrow flex size-11 shrink-0 items-center justify-center rounded-full border border-fg/15">
            <ArrowUpRight size={18} aria-hidden="true" />
          </span>
        </div>
        <Picture
          src={expertTop}
          alt="Casa de marcat Daisy eXpert SX văzută de sus"
          widths={[360, 560]}
          sizes="(min-width: 1024px) 26vw, 80vw"
          formats={['avif', 'webp']}
          class="tile-media blend-multiply pointer-events-none my-4 ml-auto w-[70%] lg:-mb-4 lg:mt-0 lg:w-[78%]"
        />
        <p class="relative max-w-[18rem] text-[0.95rem] text-muted">Punere în funcțiune, instruire și intervenții pentru modelele pe care le vindem.</p>
      </a>

      <!-- IT services: typographic tile, no stock photography -->
      <a
        href="/servicii/"
        class="tile group relative flex min-h-[22rem] flex-col justify-between overflow-hidden rounded-[var(--radius-card)] border border-fg/10 bg-white p-7 sm:p-9 lg:col-span-4"
        data-reveal="mask"
        style="--reveal-delay: 200"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow text-brand-700">Servicii IT</p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em]">Pentru firmele care nu au departament IT</h3>
          </div>
          <span class="tile-arrow flex size-11 shrink-0 items-center justify-center rounded-full border border-fg/15">
            <ArrowUpRight size={18} aria-hidden="true" />
          </span>
        </div>
        <ul class="mt-8 divide-y divide-fg/10 font-mono text-[0.82rem]">
          {
            itServices.map((s, i) => (
              <li class="flex items-center justify-between py-2.5">
                <span>{s.title}</span>
                <span class="text-muted">0{i + 1}</span>
              </li>
            ))
          }
        </ul>
      </a>
    </div>
  </div>
</section>

<style>
  .tile :global(.tile-media) {
    transition: transform 1.2s var(--ease-out-expo);
  }
  .tile:hover :global(.tile-media) {
    transform: scale(1.04) translateY(-6px) rotate(-1deg);
  }
  .tile-arrow {
    transition:
      transform 0.6s var(--ease-out-expo),
      background-color 0.4s;
  }
  .tile:hover .tile-arrow {
    transform: rotate(45deg);
    background: var(--color-brand-500);
    border-color: transparent;
    color: #fff;
  }
</style>
