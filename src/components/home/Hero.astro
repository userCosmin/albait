---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import HeroStage from '@/components/react/HeroStage';
import { responsiveImage } from '@/lib/images';
import { getProduct } from '@/data/products';
import { company } from '@/data/site';

const product = getProduct('daisy-compact-s')!;
const hero = product.images[0];
const image = await responsiveImage(hero.src, {
  widths: [420, 640, 860, 1100],
  sizes: '(min-width: 1024px) 52vw, 92vw',
});

const words = [
  { w: 'Tehnologia' },
  { w: 'potrivită', accent: true },
  { w: 'pentru' },
  { w: 'afacerea' },
  { w: 'ta.' },
];
---

<section
  class="hero relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink-950 text-ink-100"
  data-header-dark
  aria-labelledby="hero-title"
>
  <!-- Studio set: light cone, hairline grid, vignette. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="hero-cone absolute left-1/2 top-[-30vh] h-[130vh] w-[140vw] -translate-x-1/2"></div>
    <div class="grid-lines absolute inset-0 [mask-image:radial-gradient(70%_60%_at_65%_45%,black,transparent)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-950 to-transparent"></div>
  </div>

  <div class="container-x relative flex flex-1 flex-col pt-[calc(var(--header-h)+2rem)] pb-12 lg:pt-[calc(var(--header-h)+2.5rem)]">
    <div class="grid flex-1 items-start gap-y-10 lg:grid-cols-12 lg:gap-x-6">
      <div class="relative z-10 lg:col-span-6 xl:col-span-6">
        <p class="hero-fade eyebrow flex items-center gap-3 text-ink-300" style="--d: 0">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-400 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-brand-400"></span>
          </span>
          Case de marcat Daisy · Service · Alba Iulia
        </p>

        <h1 id="hero-title" class="mt-7 text-[clamp(3rem,1.1rem+5.6vw,7rem)] font-semibold leading-[0.92] tracking-[-0.05em]">
          {
            words.map((item, i) => (
              <span class="hero-word mr-[0.24em] inline-block overflow-hidden pb-[0.12em] align-bottom last:mr-0">
                <span
                  class:list={['inline-block', item.accent && 'serif-accent pr-[0.06em] text-brand-300']}
                  style={`--i: ${i}`}
                >
                  {item.w}
                </span>
              </span>
            ))
          }
        </h1>

        <p class="hero-fade mt-6 max-w-[34rem] text-lead text-ink-300" style="--d: 5">
          Descoperă casele de marcat fiscale Daisy potrivite activității tale — de la tejghea la ridesharing —
          cu suportul unei echipe din Alba Iulia, care se ocupă și de service.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/contact/#oferta" class="hero-fade btn btn-light" style="--d: 6">
            Solicită o ofertă <ArrowUpRight size={18} className="btn-icon" aria-hidden="true" />
          </a>
          <a href="/produse/" class="hero-fade btn btn-ghost-dark" style="--d: 7">
            Descoperă produsele <ArrowRight size={18} className="btn-icon" aria-hidden="true" />
          </a>
        </div>

        <dl class="hero-fade mt-10 grid max-w-[34rem] grid-cols-3 gap-4 border-t border-white/10 pt-6" style="--d: 8">
          <div>
            <dt class="eyebrow text-ink-400">Modele</dt>
            <dd class="mt-2 text-sm font-medium text-ink-100 sm:text-base">4 × Daisy</dd>
          </div>
          <div>
            <dt class="eyebrow text-ink-400">Raportare</dt>
            <dd class="mt-2 text-sm font-medium text-ink-100 sm:text-base">Jurnal electronic · ANAF</dd>
          </div>
          <div>
            <dt class="eyebrow text-ink-400">Telefon</dt>
            <dd class="mt-2 text-sm font-medium tabular-nums text-ink-100 sm:text-base">
              <a href={company.phone.href} class="link-underline">{company.phone.display}</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="relative lg:col-span-6 lg:mt-[clamp(2rem,9vh,6rem)] lg:pl-4">
        <HeroStage
          client:load
          image={image}
          alt={hero.alt}
          productName={product.name}
          productHref={`/case-de-marcat/${product.slug}/`}
          chips={['Li-Ion 2200 mAh', 'cca. 300 g', 'XML → ANAF']}
          receipt={[
            { label: 'Model', value: 'Compact S' },
            { label: 'Jurnal electronic', value: 'DA' },
            { label: 'Raport Z → ANAF', value: 'AUTO' },
            { label: 'Service local', value: 'DA' },
          ]}
        />
        <p class="hero-fade mt-6 text-center font-mono text-xs text-ink-400 lg:text-right" style="--d: 9">
          În imagine: <a href={`/case-de-marcat/${product.slug}/`} class="link-underline text-ink-300">{product.name}</a> — portabilă, pentru comerț ambulant și ridesharing
        </p>
      </div>
    </div>

    <a
      href="#gama"
      class="hero-fade group mx-auto mt-10 hidden items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-ink-400 lg:flex"
      style="--d: 10"
    >
      <span class="relative h-10 w-px overflow-hidden bg-white/15" aria-hidden="true">
        <span class="scroll-tick absolute inset-x-0 top-0 h-1/2 bg-brand-400"></span>
      </span>
      Explorează gama
    </a>
  </div>
</section>

<style>
  .hero-cone {
    background:
      radial-gradient(38% 42% at 66% 46%, rgb(255 255 255 / 0.07), transparent 70%),
      conic-gradient(from 180deg at 66% 0%, transparent 160deg, rgb(255 255 255 / 0.06) 176deg, rgb(255 255 255 / 0.1) 180deg, rgb(255 255 255 / 0.06) 184deg, transparent 200deg);
  }

  /* Headline: each word rises out of its own mask. Pure CSS, so it plays on
     first paint without waiting for JavaScript. */
  .hero-word > span {
    animation: word-rise 0.95s var(--ease-out-expo) both;
    animation-delay: calc(40ms + var(--i) * 60ms);
  }
  .hero-fade {
    animation: fade-up 0.9s var(--ease-out-expo) both;
    animation-delay: calc(120ms + var(--d) * 55ms);
  }
  :global(.hero-device-reveal) {
    animation: device-reveal 1.3s var(--ease-in-out-quart) both;
    animation-delay: 120ms;
  }
  .scroll-tick {
    animation: tick 2.2s var(--ease-in-out-quart) infinite;
  }

  @keyframes word-rise {
    from {
      transform: translate3d(0, 105%, 0) rotate(2deg);
    }
    to {
      transform: none;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes device-reveal {
    from {
      clip-path: inset(100% 0 0 0 round 2rem);
      transform: scale(1.1) translateY(4%);
    }
    to {
      clip-path: inset(-20% -20% -20% -20% round 2rem);
      transform: none;
    }
  }
  @keyframes tick {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(200%);
    }
  }
</style>
