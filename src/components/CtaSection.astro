---
import { Clock, MapPin, Phone } from 'lucide-react';
import LeadForm from '@/components/react/LeadForm';
import { company } from '@/data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
  /** square top edge, for pages where the section follows another dark block */
  flush?: boolean;
}
const { headingLevel = 'h2', flush = false } = Astro.props;
const Heading = headingLevel;
---

<section
  id="oferta"
  class:list={[
    'relative isolate overflow-hidden bg-ink-900 text-ink-100 section-y',
    !flush && 'rounded-t-[2.5rem] sm:rounded-t-[3.5rem]',
  ]}
  data-header-dark
  aria-labelledby="oferta-title"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-[20%] -top-[30%] size-[70rem] rounded-full bg-[radial-gradient(closest-side,rgb(30_143_225/0.28),transparent)]"></div>
    <div class="grid-lines absolute inset-0 [mask-image:radial-gradient(60%_50%_at_20%_20%,black,transparent)]"></div>
  </div>

  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="eyebrow text-brand-300" data-reveal>Solicită o ofertă</p>
      <Heading id="oferta-title" class="mt-5 text-[clamp(2.4rem,1.3rem+3.3vw,4.6rem)] font-semibold leading-[0.98] tracking-[-0.045em]" data-reveal style="--reveal-delay: 80">
        Hai să găsim soluția <span class="serif-accent text-brand-300">potrivită</span> pentru afacerea ta.
      </Heading>
      <p class="mt-7 max-w-md text-lead text-ink-300" data-reveal style="--reveal-delay: 160">
        Spuneți-ne pe scurt ce activitate aveți. Revenim cu modelul recomandat și cu pașii până la primul bon fiscal.
      </p>

      <ul class="mt-12 space-y-5" data-reveal style="--reveal-delay: 240">
        <li>
          <a href={company.phone.href} class="group flex items-center gap-4">
            <span class="flex size-12 items-center justify-center rounded-full bg-white/[0.07] text-brand-300 transition-colors group-hover:bg-brand-500 group-hover:text-white">
              <Phone size={20} aria-hidden="true" />
            </span>
            <span>
              <span class="block text-sm text-ink-400">Sunați-ne</span>
              <span class="text-2xl font-semibold tabular-nums tracking-[-0.02em]">{company.phone.display}</span>
            </span>
          </a>
        </li>
        <li class="flex items-center gap-4">
          <span class="flex size-12 items-center justify-center rounded-full bg-white/[0.07] text-brand-300">
            <MapPin size={20} aria-hidden="true" />
          </span>
          <span>
            <span class="block text-sm text-ink-400">Ne găsiți la</span>
            <a href={company.mapsUrl} target="_blank" rel="noopener" class="link-underline">{company.showroom.street}, {company.showroom.city}</a>
          </span>
        </li>
        <li class="flex items-center gap-4">
          <span class="flex size-12 items-center justify-center rounded-full bg-white/[0.07] text-brand-300">
            <Clock size={20} aria-hidden="true" />
          </span>
          <span>
            <span class="block text-sm text-ink-400">Program</span>
            {company.hours.display}
          </span>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay: 120">
      <div class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-6 backdrop-blur-sm sm:p-10">
        <LeadForm client:visible phone={company.phone} tone="dark" />
      </div>
    </div>
  </div>
</section>
