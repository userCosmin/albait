---
import { Plus } from 'lucide-react';
import type { FaqItem } from '@/data/faq';

interface Props {
  items: FaqItem[];
  id?: string;
  eyebrow?: string;
  title?: string;
}
const { items, id = 'intrebari', eyebrow = 'Întrebări frecvente', title = 'Ce ne întreabă clienții' } = Astro.props;
---

<section class="bg-paper section-y" aria-labelledby={`${id}-title`}>
  <div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow text-brand-600" data-reveal>{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-5 text-h2 font-semibold" data-reveal style="--reveal-delay: 80">{title}</h2>
    </div>
    <div class="border-b border-fg/12 lg:col-span-8">
      {
        items.map((f) => (
          <details class="faq group border-t border-fg/12">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold tracking-[-0.015em] sm:text-xl [&::-webkit-details-marker]:hidden">
              <h3>{f.q}</h3>
              <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full border border-fg/15 transition-transform duration-500 group-open:rotate-45 group-open:border-brand-600 group-open:bg-brand-600 group-open:text-white">
                <Plus size={16} aria-hidden="true" />
              </span>
            </summary>
            <div class="max-w-2xl pb-7 pr-12 text-[1.02rem] leading-relaxed text-muted">
              <p>{f.a}</p>
              {f.source && (
                <p class="mt-3 text-sm">
                  Sursă:{' '}
                  <a href={f.source.href} target="_blank" rel="noopener" class="text-brand-600 underline underline-offset-4">
                    {f.source.label}
                  </a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
